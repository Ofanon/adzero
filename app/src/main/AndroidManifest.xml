<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To ask the phone which resolver it would use on its own, and to send
         each question out over the network that resolver belongs to. Without
         it AdZero would have to pick a public DNS server for everybody, which
         is what it used to do. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android stops background services to save power, and a VPN that gets
         stopped protects nobody. Not for Play Store distribution anyway. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      To name and picture apps in the stats, AdZero needs to see them. The blunt
      way is QUERY_ALL_PACKAGES, but that permission reads as spyware to Play
      Protect and to anyone inspecting the manifest — reasonably so, since it
      exposes every package on the device.
      Declaring the launcher intent instead grants visibility of exactly the
      apps that have an icon in the launcher, which is the only set we ever
      show. Same feature, far smaller claim.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      Android backs app data up to the user's Google Drive by default, and the
      default is what was in force here. AdZero's data is the list of every app
      on the phone and which ad networks each one calls — a fair description of
      somebody's habits — and the app's one promise is that nothing it learns
      leaves the device. Uploading it to Google while saying that is not a
      trade-off, it is the promise being false.

      The cost is real and small: stats do not follow a phone change.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Serves AdZero's own installer to the app the user picked to send
             it. Not exported: only the chosen app gets a one-off grant. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.adzero.app.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Portrait only. Every screen is a single column built for a phone
             held upright, and landscape gained nothing but a power button
             pushed off the bottom of the page. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SilenceVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS filtering to stall advertising mediation" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Four actions for one event. BOOT_COMPLETED is the standard one;
             LOCKED_BOOT_COMPLETED fires earlier, before the phone is unlocked,
             on devices that separate the two; and the two QUICKBOOT actions are
             what Xiaomi, Huawei and HTC send instead when their fast-boot path
             is used, which is the common case on those phones. Missing them
             means protection quietly never comes back. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Exported because it has to be: the system delivers APPWIDGET_UPDATE
             from outside the app, and a widget that refuses it never draws.
             Nothing else is handled here, so that is all being accepted. -->
        <receiver
            android:name=".AdZeroWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- The widget's on/off button. Not exported: it used to share the
             receiver above, which meant any app on the phone could broadcast
             WIDGET_TOGGLE and switch protection off — the one thing an ad SDK
             sitting in another app would want. The launcher fires a
             PendingIntent AdZero built, which carries AdZero's own identity, so
             closing the door costs the button nothing. -->
        <receiver
            android:name=".ToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.adzero.app.WIDGET_TOGGLE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
