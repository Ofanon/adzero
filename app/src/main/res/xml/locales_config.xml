<?xml version="1.0" encoding="utf-8"?>
<!--
  Declaring the locales lets Android 13+ show AdZero in the per-app language
  picker, so someone whose phone is in one language can still read the app in
  another. Without this the app simply follows the system and offers no choice.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
    <locale android:name="es" />
    <locale android:name="pt-BR" />
    <locale android:name="de" />
    <locale android:name="it" />
    <locale android:name="tr" />
</locale-config>
