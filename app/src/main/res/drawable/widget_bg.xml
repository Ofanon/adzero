<?xml version="1.0" encoding="utf-8"?>
<!-- Same near-black gradient and hairline border as the app's own cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="290"
        android:startColor="#18200F"
        android:centerColor="#121711"
        android:endColor="#080A08" />
    <stroke
        android:width="1dp"
        android:color="#2A331F" />
</shape>
