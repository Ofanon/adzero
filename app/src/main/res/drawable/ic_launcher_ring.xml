<?xml version="1.0" encoding="utf-8"?>
<!--
  The ring of Oscar's AdZeroLogoV3, on Android's 108dp adaptive-icon canvas.

  Geometry kept exactly: outer radius 222.5 and inner 166 of 512, so a stroke
  of 56.5 on a mid radius of 194.25, gradient running #D8FF4A at the top to
  #6FD84A at the bottom. Scale factor 72/445, which lands the artwork on the
  72dp launchers actually display rather than the full 108dp canvas — the
  original ran edge to edge and round masks would have shaved it.

  Split out of ic_launcher_foreground because V3 puts the megaphone between
  the ring and the bar, and a layer can only be inserted between two drawables
  if they are two drawables.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,22.57 a31.43,31.43 0 1,1 -0.01,0"
        android:strokeWidth="9.14">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="18.08"
                android:endX="54" android:endY="90.08"
                android:startColor="#D8FF4A"
                android:endColor="#6FD84A" />
        </aapt:attr>
    </path>
</vector>
