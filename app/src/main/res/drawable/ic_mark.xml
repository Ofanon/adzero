<?xml version="1.0" encoding="utf-8"?>
<!--
  La marque d'AdZero en silhouette, a la taille d'une icone d'interface.

  Elle remplace un bouclier Lucide generique a deux endroits ou l'app se
  nomme : la notification permanente, donc la barre d'etat pendant toute la
  duree de la protection, et la tuile des reglages rapides. C'etait l'endroit
  le plus vu de l'app, et il ne portait pas son logo.

  Blanche et pleine, parce que le systeme teinte lui-meme une petite icone de
  notification et ignore ses couleurs : tout ce qui compte ici est le canal
  alpha. C'est aussi pour ca que le megaphone n'y est pas — a 24 dp, teint
  d'une seule couleur, il se confondrait avec l'anneau. L'anneau barre suffit
  a etre reconnu.

  Geometrie du logo ramenee de son canevas de 108 a 24 : rayon exterieur 36
  vers 11, soit un facteur 0,3056.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12,2.4 a9.6,9.6 0 1,1 -0.01,0"
        android:strokeWidth="2.79"
        android:strokeColor="#FFFFFF" />

    <path
        android:pathData="M5.08,4.09 L18.87,19.91"
        android:strokeWidth="3.21"
        android:strokeColor="#FFFFFF" />
</vector>
